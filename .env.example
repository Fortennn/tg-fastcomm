# Получить API_ID и API_HASH можно на https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Каналы для отслеживания через запятую (@канал, ссылка https://t.me/... или ID)
# Оставьте пустым, чтобы отслеживать все каналы, на которые вы подписаны
CHANNELS=@example_channel, @another_channel

# Ключевые слова для триггера (регистр не важен, частичное совпадение)
# Например: раздача, отдам, подарок, забирайте
# Если оставить пустым — будет срабатывать на любой пост
KEYWORDS=раздача, отдам

# Текст отправляемого комментария
COMMENT_TEXT=беру

# Задержка перед отправкой комментария в секундах (0 - моментально)
DELAY_SECONDS=0
